# Rimoteka backend — primer environment varijabli
#
# NIKAD ne commitovati pravi .env fajl. Na produkciji sve ovo ide u
# Coolify → Environment Variables, ne u repo.

# --- Osnovno ---
PORT=3000
NODE_ENV=production
SITE_URL=https://rimoteka.com
ALLOWED_ORIGINS=https://rimoteka.com,https://www.rimoteka.com

# --- Stripe ---
# Test režim: sk_test_... / pk_test_...  |  Produkcija: sk_live_...
# Preporuka: koristi restricted key (rk_...) sa minimalnim dozvolama.
STRIPE_SECRET_KEY=sk_test_zameni_me
STRIPE_WEBHOOK_SECRET=whsec_zameni_me
STRIPE_PRICE_MONTHLY=price_zameni_me
STRIPE_PRICE_YEARLY=price_zameni_me

# KRITIČNO: ostaviti false dok gestor ne potvrdi da su španska IVA
# registracija i Union OSS aktivni I upisani u Stripe.
# Uključen bez registracije = tiho naplaćuje 0 € PDV-a.
STRIPE_AUTOMATIC_TAX=false

# --- Supabase ---
SUPABASE_URL=https://tvoj-projekat.supabase.co
SUPABASE_ANON_KEY=zameni_me
SUPABASE_SERVICE_ROLE_KEY=zameni_me

# --- Sesija ---
# Generiši sa: openssl rand -base64 48
SESSION_SECRET=zameni_me_najmanje_32_znaka
SESSION_DAYS=30
